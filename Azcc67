-- 5. Item Magnet (ดูดของ)
CreateButton("5. ดูดของ (Item Magnet)", function(val)
    States.ItemMagnet = val
end)
RunService.RenderStepped:Connect(function()
    if States.ItemMagnet and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local HRP = LocalPlayer.Character.HumanoidRootPart
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("TouchTransporter") or (v:IsA("Part") and v.Parent:FindFirstChildOfClass("TouchTransporter")) or v:IsA("Tool") then
                if v:IsA("BasePart") then
                    v.CFrame = HRP.CFrame
                elseif v:IsA("Tool") and v:FindFirstChild("Handle") then
                    v.Handle.CFrame = HRP.CFrame
                end
            end
        end
    end
end)

