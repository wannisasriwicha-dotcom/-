-- 8. Aimbot Head (ล็อคหัว)
CreateButton("8. ล็อคหัว (Aimbot Head)", function(val)
    States.AimbotHead = val
end)

RunService.RenderStepped:Connect(function()
    if States.AimbotBody or States.AimbotHead then
        local closestPlayer = nil
        local shortestDistance = math.huge

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                local targetPart = States.AimbotHead and plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local magnitude = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                        if magnitude < shortestDistance then
                            closestPlayer = targetPart
                            shortestDistance = magnitude
                        end
                    end
                end
            end
        end

        if closestPlayer then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Position)
        end
    end
end)

-- 9. Item ESP (ดูของ)
CreateButton("9. ดูของ (Item ESP)", function(val)
    States.ItemEsp = val
    if not val then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:FindFirstChild("ItemHighlight") then
                v.ItemHighlight:Destroy()
            end
        end
    end
end)
RunService.RenderStepped:Connect(function()
    if States.ItemEsp then
        for _, v in pairs(Workspace:GetDescendants()) do
            if (v:IsA("Tool") or v:IsA("Model")) and not v:FindFirstChild("ItemHighlight") and not Players:GetPlayerFromCharacter(v) then
                local hl = Instance.new("Highlight")
                hl.Name = "ItemHighlight"
                hl.FillColor = Color3.fromRGB(255, 255, 0)
                hl.Parent = v
            end
        end
    end
end)

-- 10. Underground 100 (มุดดิน 100)
CreateButton("10. มุดดิน 100", function(val)
    States.Underground = val
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        if val then
            LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame - Vector3.new(0, 100, 0)
        else
            LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 100, 0)
        end
    end
end)

-- 11. Player ESP (ดูตำแหน่งผู้เล่น)
CreateButton("11. ดูตำแหน่งผู้เล่น (Player ESP)", function(val)
    States.PlayerEsp = val
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if val then
                if not plr.Character:FindFirstChild("PlrHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "PlrHighlight"
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.Parent = plr.Character
                end
            else
                if plr.Character:FindFirstChild("PlrHighlight") then
                    plr.Character.PlrHighlight:Destroy()
                end
            end
        end
    end
end)

